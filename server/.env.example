# Postgres 연결 문자열 (Supabase 프로비저닝 후 채움)
DATABASE_URL="postgresql://user:password@localhost:5432/albafit?schema=public"

# 손님 에이전트 호출용 OpenAI API 키 (gpt-4o-mini)
OPENAI_API_KEY=""

# 평가·루브릭 변환 에이전트 호출용 Gemini API 키 (gemini-3.5-flash)
GEMINI_API_KEY=""

# JWT 서명용 비밀키 (로컬에서는 아무 랜덤 문자열, 배포 시 Railway 환경변수로 별도 값 설정)
JWT_SECRET=""

# 회원가입 이메일 인증 발송용 Resend API 키 (resend.com에서 발급)
RESEND_API_KEY=""

# 인증 메일 발신 주소. albafit.kr 도메인을 Resend에 인증해둬서 이 주소로 발송 가능(2026-07-15).
# 도메인 인증 전이라면 Resend 기본 발신 주소(onboarding@resend.dev)로 대체해도 된다.
RESEND_FROM_EMAIL="albafit <noreply@albafit.kr>"

# 인증 메일 링크가 가리킬 프론트엔드 주소
FRONTEND_URL="http://localhost:5173"

# Express 서버 포트
PORT=4000

# 프론트(Vite dev 서버) origin — CORS 허용
CORS_ORIGIN="http://localhost:5173"
