# Postgres 연결 문자열 (Supabase 프로비저닝 후 채움)
DATABASE_URL="postgresql://user:password@localhost:5432/albafit?schema=public"

# 손님 에이전트 호출용 OpenAI API 키 (gpt-4o-mini)
OPENAI_API_KEY=""

# 평가·루브릭 변환 에이전트 호출용 Gemini API 키 (gemini-3.5-flash)
GEMINI_API_KEY=""

# Express 서버 포트
PORT=4000

# 프론트(Vite dev 서버) origin — CORS 허용
CORS_ORIGIN="http://localhost:5173"
