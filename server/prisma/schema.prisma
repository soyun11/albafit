// docs/db-schema.md 그대로 옮긴 스키마. 컬럼 추가/변경 시 db-schema.md도 함께 갱신할 것.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  linkKey   String   @unique @map("link_key") @db.VarChar(32)
  industry  String   @default("cafe") @db.VarChar(50)
  name      String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  storeRules       StoreRule[]
  scenarios        Scenario[]
  trainingSessions TrainingSession[]
  users            User[]

  @@map("stores")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash")
  role            String    @db.VarChar(20) // owner | staff
  name            String?   @db.VarChar(50)
  storeId         String?   @map("store_id") @db.Uuid
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  store                   Store?                   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  emailVerificationTokens EmailVerificationToken[]
  refreshTokens           RefreshToken[]

  @@map("users")
}

// 사장님 회원가입 시 이메일이 진짜 본인 것인지 확인하는 1회용 토큰.
// 원문은 저장하지 않고 해시만 저장한다 — 비밀번호처럼 DB가 유출돼도 토큰을 그대로 못 쓰게.
model EmailVerificationToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

// 로그인 상태를 오래 유지하기 위한 재발급용 토큰. DB에 저장해두는 이유:
// ① 서버가 특정 토큰/유저를 강제로 무효화(로그아웃)할 수 있어야 하고,
// ② 이미 무효화된 토큰이 재사용되면(도난 의심) 그 유저의 모든 토큰을 한 번에 막을 수 있어야 하기 때문.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model StoreRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  category  String?  @db.VarChar(50)
  rawText   String   @map("raw_text")
  source    String   @default("text") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_rules")
}

model Scenario {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  type         String   @db.VarChar(30)
  title        String   @db.VarChar(100)
  persona      Json
  initialState Json     @default("{}") @map("initial_state")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rubrics          Rubric[]
  trainingSessions TrainingSession[]

  @@map("scenarios")
}

model Rubric {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scenarioId String    @map("scenario_id") @db.Uuid
  criteria   Json
  version    Int       @default(1)
  approvedAt DateTime? @map("approved_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@map("rubrics")
}

model TrainingSession {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  scenarioId  String    @map("scenario_id") @db.Uuid
  staffLabel  String?   @map("staff_label") @db.VarChar(50)
  status      String    @default("in_progress") @db.VarChar(20)
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  scenario     Scenario      @relation(fields: [scenarioId], references: [id])
  sessionTurns SessionTurn[]

  @@index([storeId])
  @@map("training_sessions")
}

model SessionTurn {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  turnNumber      Int      @map("turn_number")
  customerMessage String   @map("customer_message")
  staffAnswer     String   @map("staff_answer")
  evaluation      Json
  passed          Boolean
  retryCount      Int      @default(0) @map("retry_count")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_turns")
}
